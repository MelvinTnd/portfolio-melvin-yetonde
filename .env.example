# Configuration EmailJS - IMPORTANT: Ne pas commiter le fichier .env réel
# Copiez ce fichier en .env et remplissez vos vraies clés

# Clé publique EmailJS (optionnelle, peut être publique)
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE

# Service ID EmailJS (à garder secret en production)
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID_HERE

# Template ID EmailJS (peut être public)
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID_HERE

# Email pour recevoir les messages
VITE_CONTACT_EMAIL=melvinyetonde@gmail.com

# Numéro WhatsApp avec indicatif pays
VITE_WHATSAPP_NUMBER=2290191680276
